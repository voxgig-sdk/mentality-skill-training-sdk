# Entity: exercise

main: kit: entity: exercise: {

  alias: field: {}

  fields: {
    benefits: {
      h: "Benefits"
      n: "benefits"
      r: false
      sh: "Benefits of performing this exercise"
      t: "`$ARRAY`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Category of mental skill"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the exercise"
      t: "`$STRING`"
    }
    difficulty: {
      h: "Difficulty"
      n: "difficulty"
      r: false
      sh: "Difficulty level of the exercise"
      t: "`$STRING`"
    }
    duration: {
      h: "Duration"
      n: "duration"
      r: false
      sh: "Exercise duration in minutes"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the exercise"
      t: "`$STRING`"
    }
    instructions: {
      h: "Instructions"
      n: "instructions"
      r: false
      sh: "Step-by-step instructions"
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the exercise"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "exercise"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/exercises"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "duration"
                or: "duration"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/exercises"
          q: {
            exist: [
              "category"
              "duration"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "exercises"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
